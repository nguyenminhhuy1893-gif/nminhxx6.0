<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Hminhx⚡️6.0plus</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f4f7ff}
body{
 background:#050812;
 overflow-x:hidden;
}
canvas{position:fixed;inset:0;pointer-events:none;z-index:0}
.glow{position:fixed;border-radius:50%;filter:blur(75px);opacity:.28;pointer-events:none}
.g1{width:220px;height:220px;background:#26a8ff;top:-70px;left:-60px}
.g2{width:250px;height:250px;background:#b62cff;right:-80px;bottom:-80px}
#login,#app{position:relative;z-index:2}
#login{min-height:100vh;display:grid;place-items:center;padding:20px}
.loginCard,.panel{
 background:linear-gradient(145deg,#111a2ddd,#0b1120e8);
 border:1px solid #ffffff18;border-radius:25px;
 box-shadow:0 22px 70px #0009;backdrop-filter:blur(18px)
}
.loginCard{width:min(92vw,410px);padding:32px;text-align:center}
.lock{font-size:48px;margin-bottom:10px}
h1{margin:0;font-size:27px}
.muted{color:#9da9c1;font-size:13px;margin:9px 0 22px}
input{
 width:100%;padding:14px;border-radius:13px;border:1px solid #ffffff18;
 background:#070b15;color:#fff;outline:none;text-align:center;font-size:16px
}
button{
 border:0;border-radius:12px;padding:13px 16px;color:#fff;font-weight:700;
 cursor:pointer;background:linear-gradient(135deg,#237dff,#8a38ff);
 box-shadow:0 8px 25px #4377ff35
}
.loginBtn{width:100%;margin-top:12px}
.msg{height:22px;margin-top:12px;font-size:13px}
.err{color:#ff8494}.ok{color:#77f2b2}
#app{display:none;padding:22px;max-width:850px;margin:auto}
.header{text-align:center;margin:8px 0 22px}
.brand{
 font-size:clamp(32px,8vw,54px);font-weight:900;letter-spacing:-1.5px;
 color:#fff;text-shadow:0 0 7px #fff,0 0 18px #34a9ff,0 0 38px #a43cff;
 animation:pulse 2.4s ease-in-out infinite
}
.subtitle{color:#9eabc5;font-size:13px;margin-top:5px}
@keyframes pulse{50%{text-shadow:0 0 10px #fff,0 0 25px #34a9ff,0 0 55px #a43cff}}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.panel{padding:18px}
.full{grid-column:1/-1}
.panel h2{font-size:16px;margin:0 0 15px}
.row{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid #ffffff0d}
.row:last-child{border-bottom:0}
.label b{display:block}.label span{font-size:11px;color:#77849e}
.switch{width:54px;height:30px;border-radius:30px;background:#28334b;padding:3px;transition:.2s}
.switch i{display:block;width:24px;height:24px;border-radius:50%;background:#aab4c7;transition:.2s}
.switch.on{background:#277cff;box-shadow:0 0 18px #277cff88}
.switch.on i{transform:translateX(24px);background:#fff}
button.switchBtn{background:none;box-shadow:none;padding:0}
.console{
 height:210px;overflow:hidden;background:#050812;border-radius:14px;
border:1px solid #ffffff0d;padding:13px;font-family:ui-monospace,SFMono-Regular,monospace;
 font-size:11px;color:#83d5ff;line-height:1.7
}
.line{white-space:nowrap;opacity:.9}
.status{display:flex;align-items:center;gap:8px;font-size:12px;color:#8f9cb6}
.dot{width:8px;height:8px;border-radius:50%;background:#39ef91;box-shadow:0 0 10px #39ef91}
.footer{text-align:center;color:#58657d;font-size:10px;margin:18px}
.logout{background:#ffffff0d;box-shadow:none;margin-top:5px}
@media(max-width:620px){.grid{grid-template-columns:1fr}.full{grid-column:auto}#app{padding:15px}}
</style>
</head>
<body>
<div class="glow g1"></div><div class="glow g2"></div><canvas id="snow"></canvas>

<section id="login">
 <div class="loginCard">
  <div class="lock">🔐</div>
  <h1>Secure Access</h1>
  <div class="muted">Nhập mật khẩu chính xác để mở Hminhx⚡️6.0plus</div>
  <input id="pass" type="password" placeholder="Mật khẩu">
  <button class="loginBtn" onclick="login()">MỞ ỨNG DỤNG</button>
  <div id="msg" class="msg"></div>
 </div>
</section>

<main id="app">
 <header class="header">
  <div class="brand">Hminhx⚡️6.0plus</div>
  <div class="subtitle">PERFORMANCE CONTROL • VISUAL DEMO</div>
 </header>

 <section class="grid">
  <div class="panel">
   <h2>🎯 Chế độ hỗ trợ</h2>
   <div class="row"><div class="label"><b>Nhẹ tâm</b><span>Mô phỏng giao diện điều khiển</span></div><button class="switchBtn" onclick="toggle(this)"><div class="switch"><i></i></div></button></div>
   <div class="row"><div class="label"><b>Bám đầu</b><span>Chỉ là mô phỏng UI, không can thiệp game</span></div><button class="switchBtn" onclick="toggle(this)"><div class="switch"><i></i></div></button></div>
  </div>

  <div class="panel">
   <h2>⚡ Tối ưu máy</h2>
   <div class="row"><div class="label"><b>FPS cao</b><span>Giao diện trạng thái hiệu năng</span></div><button class="switchBtn" onclick="toggle(this)"><div class="switch"><i></i></div></button></div>
   <div class="row"><div class="label"><b>Performance Mode</b><span>Mô phỏng chế độ hiệu năng</span></div><button class="switchBtn" onclick="toggle(this)"><div class="switch"><i></i></div></button></div>
  </div>

  <div class="panel full">
   <h2>💻 Chương trình đang chạy</h2>
   <div class="status"><span class="dot"></span><span id="run">SYSTEM READY • SIMULATION ACTIVE</span></div>
   <div class="console" id="console"></div>
  </div>
 </section>
 <div style="text-align:center"><button class="logout" onclick="logout()">🔒 Khóa ứng dụng</button></div>
 <div class="footer">Hminhx⚡️6.0plus • Demo giao diện — không thay đổi thiết bị hoặc can thiệp trò chơi</div>
</main>

<script>
const PASSWORD="NMinhx"; // Đổi mật khẩu tại đây

function login(){
 const p=document.getElementById('pass'),m=document.getElementById('msg');
 if(p.value===PASSWORD){
m.className='msg ok';m.textContent='✓ Mật khẩu chính xác';
   setTimeout(()=>{document.getElementById('login').style.display='none';document.getElementById('app').style.display='block';startConsole()},280);
 }else{
   m.className='msg err';m.textContent='✕ Sai mật khẩu — không thể vào app';
   p.value='';p.focus();
 }
}
function logout(){
 document.getElementById('app').style.display='none';
 document.getElementById('login').style.display='grid';
 document.getElementById('msg').textContent='';
}
function toggle(btn){
 const s=btn.querySelector('.switch');s.classList.toggle('on');
}
const logs=[
 'boot > initializing Hminhx core...',
 'auth > session verified',
 'module > performance monitor loaded',
 'module > visual control panel ready',
 'fps > monitoring frame-rate state...',
 'memory > checking simulated memory state...',
 'render > adaptive interface enabled',
 'network > no external game process attached',
 'status > all demo modules operational',
 'loop > heartbeat OK'
];
let li=0;
function startConsole(){
 const box=document.getElementById('console');
 setInterval(()=>{
  const d=document.createElement('div');d.className='line';
  const t=new Date().toLocaleTimeString();
  d.textContent=`[${t}] ${logs[li++%logs.length]}`;
  box.appendChild(d);
  while(box.children.length>10)box.removeChild(box.firstChild);
  box.scrollTop=box.scrollHeight;
 },650);
}

// Snow animation
const c=document.getElementById('snow'),ctx=c.getContext('2d');let flakes=[];
function resize(){c.width=innerWidth;c.height=innerHeight}
function seed(){flakes=Array.from({length:85},()=>({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*2.8+.6,v:Math.random()*1.4+.4,s:(Math.random()-.5)*.35}))}
function snow(){
 ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='rgba(255,255,255,.8)';
 for(const f of flakes){ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,Math.PI*2);ctx.fill();f.y+=f.v;f.x+=f.s;if(f.y>c.height+5){f.y=-5;f.x=Math.random()*c.width}}
 requestAnimationFrame(snow)
}
addEventListener('resize',()=>{resize();seed()});resize();seed();snow();
</script>
</body>
</html>
